WITH plain AS MATERIALIZED (SELECT * FROM read_arrow('{DATA_PATH}/lookup.arrow'))
SELECT count(*) FROM (
	(SELECT * FROM (SELECT * FROM read_arrow('{DATA_PATH}/lookup.arrow') WHERE grp = 3 ORDER BY score, id LIMIT 100) EXCEPT ALL SELECT * FROM (SELECT * FROM plain WHERE grp = 3 ORDER BY score, id LIMIT 100))
	UNION ALL
	(SELECT * FROM (SELECT * FROM plain WHERE grp = 3 ORDER BY score, id LIMIT 100) EXCEPT ALL SELECT * FROM (SELECT * FROM read_arrow('{DATA_PATH}/lookup.arrow') WHERE grp = 3 ORDER BY score, id LIMIT 100))
)
----
0

query I
WITH plain AS MATERIALIZED (SELECT * FROM read_arrow('{DATA_PATH}/lookup.arrow'))
SELECT count(*) FROM (
	(SELECT * FROM (SELECT * FROM read_arrow('{DATA_PATH}/lookup.arrow') WHERE price IS NULL AND id > 20000 ORDER BY score DESC, id LIMIT 30) EXCEPT ALL SELECT * FROM (SELECT * FROM plain WHERE price IS NULL AND id > 20000 ORDER BY score DESC, id LIMIT 30))
	UNION ALL
	(SELECT * FROM (SELECT * FROM plain WHERE price IS NULL AND id > 20000 ORDER BY score DESC, id LIMIT 30) EXCEPT ALL SELECT * FROM (SELECT * FROM read_arrow('{DATA_PATH}/lookup.arrow') WHERE price IS NULL AND id > 20000 ORDER BY score DESC, id LIMIT 30))
)
----
0

