	(SELECT * FROM read_arrow('{DATA_PATH}/pushdown.arrow') WHERE ts >= TIMESTAMP '2024-01-01 10:59:00' AND ts < TIMESTAMP '2024-01-01 11:00:00' EXCEPT ALL SELECT * FROM expected WHERE ts >= TIMESTAMP '2024-01-01 10:59:00' AND ts < TIMESTAMP '2024-01-01 11:00:00')
	UNION ALL
	(SELECT * FROM expected WHERE ts >= TIMESTAMP '2024-01-01 10:59:00' AND ts < TIMESTAMP '2024-01-01 11:00:00' EXCEPT ALL SELECT * FROM read_arrow('{DATA_PATH}/pushdown.arrow') WHERE ts >= TIMESTAMP '2024-01-01 10:59:00' AND ts < TIMESTAMP '2024-01-01 11:00:00')
)
