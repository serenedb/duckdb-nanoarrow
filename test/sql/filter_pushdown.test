query III
SELECT count(*), min(id), max(id) FROM read_arrow('{DATA_PATH}/pushdown.arrow') WHERE ts >= TIMESTAMP '2024-01-01 10:59:00' AND ts < TIMESTAMP '2024-01-01 11:00:00'
