statement ok
CREATE TABLE dict AS FROM read_arrow('__WORKING_DIRECTORY__/data/dictionary_file.arrow');

query I
SELECT count(*) FROM read_arrow('__WORKING_DIRECTORY__/data/dictionary_file.arrow') WHERE d = 'beta'
----
28000

query I
SELECT count(*) FROM (
	(SELECT * FROM read_arrow('__WORKING_DIRECTORY__/data/dictionary_file.arrow') WHERE d = 'beta' AND v > 70000 EXCEPT ALL SELECT * FROM dict WHERE d = 'beta' AND v > 70000)
	UNION ALL
	(SELECT * FROM dict WHERE d = 'beta' AND v > 70000 EXCEPT ALL SELECT * FROM read_arrow('__WORKING_DIRECTORY__/data/dictionary_file.arrow') WHERE d = 'beta' AND v > 70000)
)
----
0

statement ok
COPY (SELECT i AS k, i::INTEGER AS v FROM range(5000) t(i)) TO '{DATA_PATH}/union_int.arrow' (FORMAT ARROW, ROW_GROUP_SIZE 2048);

statement ok
COPY (SELECT i AS k, CASE WHEN i % 2 = 0 THEN i::VARCHAR ELSE 'x' || i::VARCHAR END AS v FROM range(5000) t(i)) TO '{DATA_PATH}/union_str.arrow' (FORMAT ARROW, ROW_GROUP_SIZE 2048);

statement ok
CREATE TABLE union_expected AS FROM read_arrow(['{DATA_PATH}/union_int.arrow', '{DATA_PATH}/union_str.arrow'], union_by_name = true);

query II
SELECT k, v FROM read_arrow(['{DATA_PATH}/union_int.arrow', '{DATA_PATH}/union_str.arrow'], union_by_name = true) WHERE v IN ('7', 'x7', '8') ORDER BY k, v
----
7	7
7	x7
8	8
8	8

query I
SELECT count(*) FROM (
	(SELECT * FROM read_arrow(['{DATA_PATH}/union_int.arrow', '{DATA_PATH}/union_str.arrow'], union_by_name = true) WHERE v = 'x9' OR v = '9' EXCEPT ALL SELECT * FROM union_expected WHERE v = 'x9' OR v = '9')
	UNION ALL
	(SELECT * FROM union_expected WHERE v = 'x9' OR v = '9' EXCEPT ALL SELECT * FROM read_arrow(['{DATA_PATH}/union_int.arrow', '{DATA_PATH}/union_str.arrow'], union_by_name = true) WHERE v = 'x9' OR v = '9')
)
----
0
