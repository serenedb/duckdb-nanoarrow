# name: test/sql/filter_pushdown.test
# description: Filters pushed into read_arrow return what the same filters return above the scan
# group: [sql]

require nanoarrow

test-env DATA_PATH {TEST_DIR}

statement ok
SET threads = 4;

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
CREATE TABLE src AS SELECT
    i AS id,
    i % 7 AS grp,
    md5(i::VARCHAR) AS name,
    repeat(md5(i::VARCHAR), 4) AS payload,
    DATE '2024-01-01' + (i // 100)::INTEGER AS day,
    TIMESTAMP '2024-01-01' + to_seconds(i) AS ts,
    (i * 0.01)::DECIMAL(18, 2) AS price,
    (i * 0.0001)::DECIMAL(38, 4) AS big,
    CASE WHEN i % 10 = 0 THEN i END AS sparse,
    CASE WHEN i % 3 = 0 THEN NULL ELSE 'v' || (i % 50)::VARCHAR END AS tag,
    {'a': i, 'b': 'w' || i::VARCHAR} AS s,
    [i, i + 1] AS l
FROM range(40000) t(i);

statement ok
COPY src TO '{DATA_PATH}/pushdown.arrow' (FORMAT ARROW, ROW_GROUP_SIZE 5000);

statement ok
COPY src TO '{DATA_PATH}/pushdown.arrows' (FORMAT ARROWS, ROW_GROUP_SIZE 5000);

statement ok
CREATE TABLE expected AS FROM read_arrow('{DATA_PATH}/pushdown.arrow');

query II
EXPLAIN SELECT id FROM read_arrow('{DATA_PATH}/pushdown.arrow') WHERE grp = 3
----
physical_plan	<REGEX>:.*READ_ARROW.*Column Filter: grp = 3.*

query I
SELECT count(*) FROM read_arrow('{DATA_PATH}/pushdown.arrow') WHERE grp = 3 AND id > 1000
----
5571

query I
SELECT count(*) FROM (
	(SELECT * FROM read_arrow('{DATA_PATH}/pushdown.arrow') WHERE grp = 3 AND id > 1000 EXCEPT ALL SELECT * FROM expected WHERE grp = 3 AND id > 1000)
	UNION ALL
	(SELECT * FROM expected WHERE grp = 3 AND id > 1000 EXCEPT ALL SELECT * FROM read_arrow('{DATA_PATH}/pushdown.arrow') WHERE grp = 3 AND id > 1000)
)
----
0

query III
SELECT count(*), min(id), max(id) FROM read_arrow('{DATA_PATH}/pushdown.arrow') WHERE id BETWEEN 37000 AND 37010
----
11	37000	37010

query I
SELECT count(*) FROM (
	(SELECT * FROM read_arrow('{DATA_PATH}/pushdown.arrow') WHERE id BETWEEN 37000 AND 37010 EXCEPT ALL SELECT * FROM expected WHERE id BETWEEN 37000 AND 37010)
	UNION ALL
	(SELECT * FROM expected WHERE id BETWEEN 37000 AND 37010 EXCEPT ALL SELECT * FROM read_arrow('{DATA_PATH}/pushdown.arrow') WHERE id BETWEEN 37000 AND 37010)
)
----
0

query I
SELECT count(*) FROM read_arrow('{DATA_PATH}/pushdown.arrow') WHERE id > 100000
----
0

query IIII
SELECT id, payload = repeat(name, 4), s, l FROM read_arrow('{DATA_PATH}/pushdown.arrow') WHERE name = md5('12345')
----
12345	true	{'a': 12345, 'b': w12345}	[12345, 12346]

query I
SELECT (SELECT count(*) FROM read_arrow('{DATA_PATH}/pushdown.arrow') WHERE name >= 'fe') = (SELECT count(*) FROM src WHERE name >= 'fe')
----
true

query I
SELECT count(*) FROM (
	(SELECT * FROM read_arrow('{DATA_PATH}/pushdown.arrow') WHERE name >= 'fe' EXCEPT ALL SELECT * FROM expected WHERE name >= 'fe')
	UNION ALL
	(SELECT * FROM expected WHERE name >= 'fe' EXCEPT ALL SELECT * FROM read_arrow('{DATA_PATH}/pushdown.arrow') WHERE name >= 'fe')
)
----
0

query II
SELECT count(*), count(DISTINCT id % 3) FROM read_arrow('{DATA_PATH}/pushdown.arrow') WHERE tag = 'v7'
----
533	2

query I
SELECT count(*) FROM (
	(SELECT * FROM read_arrow('{DATA_PATH}/pushdown.arrow') WHERE tag = 'v7' EXCEPT ALL SELECT * FROM expected WHERE tag = 'v7')
	UNION ALL
	(SELECT * FROM expected WHERE tag = 'v7' EXCEPT ALL SELECT * FROM read_arrow('{DATA_PATH}/pushdown.arrow') WHERE tag = 'v7')
)
