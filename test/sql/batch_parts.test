# name: test/sql/batch_parts.test
# description: Threads read the row ranges of one large record batch, which they decode once
# group: [sql]

require nanoarrow

test-env DATA_PATH {TEST_DIR}

statement ok
SET threads = 1;

statement ok
COPY (
    SELECT i, i % 7 AS k, CASE WHEN i % 5 = 0 THEN NULL ELSE md5(i::VARCHAR) END AS s, [i, i + 1] AS l,
           {'a': i, 'b': i::VARCHAR} AS st
    FROM range(400000) t(i)
) TO '{DATA_PATH}/one_batch.arrow' (FORMAT ARROW, ROW_GROUP_SIZE 400000);

statement ok
SET threads = 8;

statement ok
CREATE TABLE t AS FROM read_arrow('{DATA_PATH}/one_batch.arrow');

query IIIIIII
SELECT count(*), count(*) FILTER (WHERE i != rowid), sum(i), count(s), count(*) FILTER (WHERE s != md5(i::VARCHAR)),
       sum(l[2]), count(*) FILTER (WHERE st.a != i OR st.b != i::VARCHAR)
FROM t;
----
400000	0	79999800000	320000	0	80000200000	0

query II
SELECT count(*), count(*) FILTER (WHERE file_row_number != i) FROM read_arrow('{DATA_PATH}/one_batch.arrow');
----
400000	0

query I
SELECT count(*) FROM read_arrow('{DATA_PATH}/one_batch.arrow');
----
400000

query II
SELECT count(*), sum(i) FROM read_arrow('{DATA_PATH}/one_batch.arrow') WHERE k = 3;
----
57143	11428600000

query II
SELECT count(*), sum(i) FROM read_arrow('{DATA_PATH}/one_batch.arrow') WHERE s IS NULL;
----
80000	15999800000

statement ok
COPY (FROM read_arrow('{DATA_PATH}/one_batch.arrow')) TO '{DATA_PATH}/one_batch_2.arrow' (FORMAT ARROW, ROW_GROUP_SIZE 400000);

query III
SELECT count(*), sum(i), count(s) FROM read_arrow('{DATA_PATH}/one_batch*.arrow');
----
800000	159999600000	640000

# A compressed body is decoded by the thread that reads it
statement ok
SET threads = 1;

statement ok
COPY (FROM read_arrow('{DATA_PATH}/one_batch.arrow')) TO '{DATA_PATH}/one_batch_zstd.arrow' (FORMAT ARROW, ROW_GROUP_SIZE 400000, COMPRESSION zstd);

statement ok
SET threads = 8;

query IIII
SELECT count(*), count(*) FILTER (WHERE file_row_number != i), sum(i), count(s) FROM read_arrow('{DATA_PATH}/one_batch_zstd.arrow');
----
400000	0	79999800000	320000

# Ten thousand rows of 1 KB make eight parts of 2048 rows, the last three of them empty
statement ok
SET threads = 1;

statement ok
COPY (SELECT i, repeat(chr((65 + i % 26)::INTEGER), 1000) AS s FROM range(10000) t(i)) TO '{DATA_PATH}/wide_batch.arrow' (FORMAT ARROW, ROW_GROUP_SIZE 10000);

statement ok
SET threads = 8;

query IIII
SELECT count(*), count(*) FILTER (WHERE file_row_number != i), sum(i), count(*) FILTER (WHERE s != repeat(chr((65 + i % 26)::INTEGER), 1000)) FROM read_arrow('{DATA_PATH}/wide_batch.arrow');
----
10000	0	49995000	0

query I
SELECT count(*) FROM read_arrow('{DATA_PATH}/wide_batch.arrow');
----
10000
