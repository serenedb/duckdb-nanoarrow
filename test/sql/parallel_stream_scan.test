# name: test/sql/parallel_stream_scan.test
# description: Threads claim ranges of the record batches of a stream in a regular file, found from its message headers
# group: [sql]

require nanoarrow

test-env DATA_PATH {TEST_DIR}

statement ok
COPY (SELECT i, i % 7 AS k, md5(i::VARCHAR) AS s FROM range(300000) t(i)) TO '{DATA_PATH}/claims.arrows' (FORMAT ARROWS, ROW_GROUP_SIZE 10000);

statement ok
COPY (FROM read_arrow('{DATA_PATH}/claims.arrows')) TO '{DATA_PATH}/claims_zstd.arrows' (FORMAT ARROWS, ROW_GROUP_SIZE 10000, COMPRESSION 'zstd');

statement ok
SET threads = 4;

statement ok
CREATE TABLE t AS FROM read_arrow('{DATA_PATH}/claims.arrows');

query III
SELECT count(*), count(*) FILTER (WHERE i != rowid), sum(i) FROM t;
----
300000	0	44999850000

query II
SELECT count(*), sum(i) FROM read_arrow('{DATA_PATH}/claims.arrows') WHERE k = 3;
----
42857	6428507143

query I
SELECT count(*) FROM read_arrow('{DATA_PATH}/claims.arrows');
----
300000

query II
SELECT count(*), count(*) FILTER (WHERE i != file_row_number) FROM read_arrow('{DATA_PATH}/claims.arrows');
----
300000	0

statement ok
CREATE TABLE z AS FROM read_arrow('{DATA_PATH}/claims_zstd.arrows');

query IIII
SELECT count(*), count(*) FILTER (WHERE i != rowid), sum(i), max(s) FROM z;
----
300000	0	44999850000	fffffe98d0963d27015c198262d97221

query I
SELECT count(*) FROM read_arrow('{DATA_PATH}/claims_zstd.arrows');
----
300000

query II
SELECT count(*), max(s) FROM read_arrow('{DATA_PATH}/claims*.arrows');
----
600000	fffffe98d0963d27015c198262d97221

# A stream with dictionary batches is read in order, as one scan
query I
SELECT count(*) = count(DISTINCT file_row_number) AND min(file_row_number) = 0 FROM read_arrow('__WORKING_DIRECTORY__/data/dictionary_large.arrows');
----
true
